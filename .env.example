# Local defaults. The npm scripts load .env when present.
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787
DB_PATH=./data/qori.sqlite
NODE_ENV=development

# Number of trusted proxy hops. Keep 0 for direct local access.
# The supplied Docker Compose + host Caddy example uses 1.
TRUST_PROXY=0

# Defaults automatically from PUBLIC_BASE_URL: HTTPS -> true, HTTP -> false.
# COOKIE_SECURE=true

# Vercel only: link a private Vercel Blob store to provide BLOB_READ_WRITE_TOKEN
# and set DATABASE_URL to a hosted PostgreSQL connection string (for example Neon).
# Vercel deployment also needs TRUST_PROXY=1 and a stable public HTTPS PUBLIC_BASE_URL.

# Cashfree subscriptions: leave OFF until merchant onboarding and sandbox tests pass.
CASHFREE_SUBSCRIPTIONS_ENABLED=false
CASHFREE_ENFORCE_LIMITS=false
CASHFREE_ENVIRONMENT=sandbox
# CASHFREE_CLIENT_ID=...
# CASHFREE_SECRET_KEY=...
# CASHFREE_WEBHOOK_SECRET=...
# CASHFREE_PLAN_ID=...
# FREE_QR_LIMIT=10
