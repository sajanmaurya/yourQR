# Local defaults. The npm scripts load .env when present.
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787
DB_PATH=./data/qori.sqlite
NODE_ENV=development

# Required for first-owner setup when NODE_ENV=production.
# Set a long random value and enter it in the initial setup screen.
SETUP_TOKEN=

# Number of trusted proxy hops. Keep 0 for direct local access.
# The supplied Docker Compose + host Caddy example uses 1.
TRUST_PROXY=0

# Defaults automatically from PUBLIC_BASE_URL: HTTPS -> true, HTTP -> false.
# COOKIE_SECURE=true

# Experimental SaaS account registration. Leave false on public deployments until hardened.
SAAS_MODE=false

# Required for production SaaS email verification (server-side only).
RESEND_API_KEY=
MAIL_FROM=

# Optional. When set, the Express runtime uses PostgreSQL instead of SQLite.
# Set with a private URL in .env or host secrets, never in a committed file.
# DATABASE_URL=postgresql://qori:your-secret@db.example.com:5432/qori?sslmode=require

# Cloudflare R2 for direct PDF uploads and large PDF delivery (server-side only).
# Leave all unset to retain the existing local/small-file storage mode.
# Never prefix these with VITE_, and never commit real values.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
